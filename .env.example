# Copiar este archivo a .env y completar con valores reales.
# .env, .env.test y .env.* están en .gitignore — nunca commitear valores reales.

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=healthper

# Google OAuth (Passport)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Groq (Whisper + Llama para resumenes/chat/preguntas sugeridas)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Seguridad / JWT
JWT_SECRET=your_jwt_secret_min_32_chars_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars_here

# Feature flags
ALLOW_REGISTER=true
ALLOW_DEMO=true

# Frontend
FRONTEND_URL=http://localhost:5173

# Resend (email transaccional)
RESEND_API_KEY=your_resend_api_key_here
